{
  "expo": {
    "name": "CodeViewer",
    "slug": "CodeViewer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#0D1117",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rajankumarsingh.codeviewer"
    },
    "android": {
      "package": "com.rajankumarsingh.codeviewer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "23e471ed-10af-4d7f-9e0a-03f6729660ce"
      }
    },
    "owner": "rajankumarsingh",
    "plugins": [
      "expo-font"
    ]
  }
}
